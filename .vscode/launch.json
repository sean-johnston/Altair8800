    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Altair8800",
            "stopAtEntry": false,
            "externalConsole": false,
            "environment": [],
